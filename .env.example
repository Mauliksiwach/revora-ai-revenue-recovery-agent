# ==============================================================================
# REVORA — AI Revenue Recovery Agent
# Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend API URL (for Vite)
VITE_API_URL=http://localhost:5000/api/v1

# Supabase Configuration (Optional - in-memory fallback enabled by default)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Test Mode Credentials (Optional - test/simulation mode enabled by default)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxx

# Simulation Configuration
SIMULATION_DATA_SIZE=1200
ENABLE_IN_MEMORY_FALLBACK=true